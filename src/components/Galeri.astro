---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  items: Item[];
  limit?: number;
}
const { items, limit } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
---

<div class="gallery">
  {
    shown.map((it, i) => (
      <figure class="gallery__item">
        <a href={`#foto-${i}`} class="gallery__link" aria-label="Fotoğrafı büyüt">
          <Image src={it.src} alt={it.alt} widths={[320, 480, 640]} sizes="(max-width: 640px) 50vw, 320px" loading="lazy" />
        </a>
      </figure>
    ))
  }
</div>

{
  shown.map((it, i) => (
    <div class="lightbox" id={`foto-${i}`}>
      <a href="#" class="lightbox__close" aria-label="Kapat">×</a>
      <a href="#" class="lightbox__bg" tabindex="-1" aria-hidden="true" />
      <figure class="lightbox__figure">
        <Image src={it.src} alt={it.alt} widths={[640, 900, 1200]} sizes="90vw" loading="lazy" />
      </figure>
    </div>
  ))
}

<style>
  .gallery {
    column-count: 3;
    column-gap: 14px;
  }
  @media (max-width: 860px) {
    .gallery {
      column-count: 2;
    }
  }
  @media (max-width: 460px) {
    .gallery {
      column-count: 2;
      column-gap: 10px;
    }
  }
  .gallery__item {
    break-inside: avoid;
    margin: 0 0 14px;
  }
  .gallery__link {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .gallery__link img {
    width: 100%;
    height: auto;
    transition: transform 0.4s ease;
  }
  .gallery__link:hover {
    box-shadow: var(--shadow-md);
  }
  .gallery__link:hover img {
    transform: scale(1.05);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .lightbox:target {
    display: flex;
  }
  .lightbox__bg {
    position: absolute;
    inset: 0;
    background: rgba(6, 30, 33, 0.9);
    backdrop-filter: blur(4px);
  }
  .lightbox__figure {
    position: relative;
    max-width: min(92vw, 720px);
    max-height: 88vh;
    margin: 0;
  }
  .lightbox__figure img {
    width: 100%;
    height: auto;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
  }
  .lightbox__close {
    position: absolute;
    top: 18px;
    right: 22px;
    z-index: 2;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    line-height: 1;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
  }
  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.24);
  }
</style>
