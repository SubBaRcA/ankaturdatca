---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  image: ImageMetadata;
  objectPosition?: string;
}

const { title, subtitle, eyebrow, image, objectPosition = '50% 45%' } = Astro.props;
---

<section class="page-hero">
  <Image src={image} alt="" class="page-hero__img" widths={[720, 1080, 1600]} sizes="100vw" loading="eager" />
  <div class="page-hero__scrim"></div>
  <div class="container page-hero__inner">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="page-hero__sub">{subtitle}</p>}
  </div>
</section>

<style define:vars={{ objectPosition }}>
  .page-hero {
    position: relative;
    min-height: clamp(300px, 44vw, 440px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }
  .page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--objectPosition);
    z-index: -2;
  }
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(6, 37, 41, 0.86) 6%, rgba(6, 37, 41, 0.35) 55%, rgba(6, 37, 41, 0.1) 100%);
  }
  .page-hero__inner {
    padding-block: clamp(30px, 5vw, 56px);
    max-width: 760px;
  }
  .page-hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    text-shadow: 0 2px 24px rgba(3, 26, 29, 0.4);
  }
  .page-hero__eyebrow {
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--coral-soft);
    margin-bottom: 12px;
  }
  .page-hero__sub {
    color: #e7f2f2;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    max-width: 56ch;
    margin-top: 14px;
    text-shadow: 0 1px 14px rgba(3, 26, 29, 0.4);
  }
</style>
