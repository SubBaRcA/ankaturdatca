---
import { site } from '../data/site';
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappText)}`;
---

<a class="wa-fab" href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp ile yazın">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.1 1.6 5.9L4 29l8.3-1.6c1.7.9 3.6 1.4 5.7 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.3-.4A9.8 9.8 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.6-7.3c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.1 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.4z"
    ></path>
  </svg>
  <span class="wa-label">Rezervasyon / Bilgi</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 14px;
    background: #25d366;
    color: #08331b;
    font-weight: 800;
    border-radius: 999px;
    box-shadow: 0 12px 30px rgba(7, 51, 27, 0.35);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .wa-fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(7, 51, 27, 0.42);
  }
  .wa-label {
    font-size: 0.92rem;
  }
  @media (max-width: 560px) {
    .wa-label {
      display: none;
    }
    .wa-fab {
      padding: 14px;
    }
  }
</style>
