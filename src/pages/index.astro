---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TurKarti from '../components/TurKarti.astro';
import Galeri from '../components/Galeri.astro';
import CTABand from '../components/CTABand.astro';
import { site, tours, coves, menu } from '../data/site';
import { img } from '../data/images';
import { gallery } from '../data/images';

const features = [
  {
    t: `Maksimum ${site.capacity} kişi`,
    d: '40-50 kişilik kalabalık tekneler yerine, tamamen size ait küçük bir tekne. Sıra beklemek, itişmek yok.',
    icon: 'M3 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2M5 13V8l7-4 7 4v5',
  },
  {
    t: 'Sadece kendi grubunuz',
    d: 'Genelde arkadaş ve aile grupları geliyor. Karışık grup olmadığı için gün tamamen sizin keyfinize göre akıyor.',
    icon: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7 1a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 19c0-3 3-5 6-5s6 2 6 5m1-5c2 0 5 1 5 4',
  },
  {
    t: 'Esnek rota ve program',
    d: 'Rota sabit değil. O günkü hava ve deniz durumuna, sizin isteğinize göre en güzel koyları seçiyoruz.',
    icon: 'M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  },
  {
    t: 'Yemek ve ikramlar dahil',
    d: `Öğle yemeği (${menu.lunch}) ve gün boyu ikramlar dahil. Siz sadece denizin keyfini çıkarın.`,
    icon: 'M4 3v18M4 3c3 0 3 5 0 5m14-5v18m0-9c-3 0-3-5 0-5M11 3v7a2 2 0 0 1-2 2',
  },
];
---

<Layout>
  <Hero />

  <!-- Fark -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Neden Anka Tur</p>
        <h2>Aynı koylar, bambaşka bir gün</h2>
        <p class="lead">
          Datça’nın en güzel koylarına biz de gidiyoruz. Farkımız nasıl gittiğimizde: kalabalıkta değil,
          size özel bir teknede.
        </p>
      </div>
      <div class="grid grid--2 features">
        {
          features.map((f) => (
            <div class="feature card">
              <span class="feature__icon">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={f.icon} />
                </svg>
              </span>
              <div>
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Deneyim / split -->
  <section class="section split">
    <div class="container split__grid">
      <div class="split__media">
        <Image src={img.coveLadder} alt="Datça’da berrak bir koyda tekne merdiveni" widths={[480, 720, 900]} sizes="(max-width: 900px) 100vw, 460px" loading="lazy" />
        <span class="split__badge">Max {site.capacity} kişi · Size özel</span>
      </div>
      <div class="split__text">
        <p class="eyebrow">Deneyim</p>
        <h2>Sabah {site.timeDepart}’da denize, akşam {site.timeReturn}’de huzurla limana</h2>
        <p class="lead">
          {site.departurePoint}’ndan kalkıyor, İnceburun hattındaki saklı koylara doğru yola çıkıyoruz.
          Gün boyu yüzme molaları, fotoğraf durakları ve teknede hazırlanan taze bir öğle yemeği.
        </p>
        <ul class="split__list">
          <li>Berrak koylarda dilediğiniz kadar yüzme</li>
          <li>Taze öğle yemeği: {menu.lunch}</li>
          <li>{menu.extras}</li>
          <li>Deneyimli kaptan: {site.captain}</li>
        </ul>
        <a href="/teknemiz" class="btn btn--ghost">Teknemizi tanıyın</a>
      </div>
    </div>
  </section>

  <!-- Turlar -->
  <section class="section section--tight" style="background: var(--sand);">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Turlar</p>
        <h2>Size uygun turu seçin</h2>
      </div>
      <div class="grid grid--3">
        {tours.map((t, i) => <TurKarti {...t} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- Koylar -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Rotalar & Koylar</p>
        <h2>İnceburun hattının saklı koyları</h2>
        <p class="lead">
          Rotayı sabit yazmıyoruz; en güzel duraklar o günkü koşullara göre seçilir. Küçük ve esnek
          olduğumuz için sizin için en doğru koyları rahatça planlarız.
        </p>
      </div>
      <div class="coves">
        {coves.map((c) => <span class="cove-chip">{c.name}</span>)}
      </div>
      <a href="/rotalar" class="btn btn--sea coves__cta">Koyları ve rotayı keşfedin</a>
    </div>
  </section>

  <!-- Galeri -->
  <section class="section section--tight" style="background: var(--sand);">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Galeri</p>
        <h2>Sizi bekleyen manzaralar</h2>
      </div>
      <Galeri items={gallery} limit={6} />
      <a href="/galeri" class="btn btn--ghost galeri__cta">Tüm galeriyi gör</a>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .features {
    gap: 20px;
  }
  .feature {
    display: flex;
    gap: 16px;
    padding: 24px;
  }
  .feature__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--lagoon-soft);
    color: var(--sea-deep);
  }
  .feature h3 {
    margin-bottom: 6px;
  }

  .split__grid {
    display: grid;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .split__grid {
      grid-template-columns: 460px 1fr;
    }
  }
  .split__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .split__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .split__badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    background: rgba(6, 37, 41, 0.72);
    backdrop-filter: blur(6px);
    color: #fff;
    font-weight: 700;
    font-size: 0.86rem;
    padding: 8px 14px;
    border-radius: 999px;
  }
  .split__list {
    list-style: none;
    padding: 0;
    margin: 20px 0 26px;
    display: grid;
    gap: 10px;
  }
  .split__list li {
    position: relative;
    padding-left: 28px;
    color: var(--ink);
  }
  .split__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 4px rgba(239, 106, 60, 0.16);
  }

  .coves {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
  }
  .cove-chip {
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-weight: 700;
    color: var(--sea-ink);
    box-shadow: var(--shadow-sm);
  }
  .coves__cta,
  .galeri__cta {
    margin-top: 6px;
  }
  .galeri__cta {
    margin-top: 28px;
  }
</style>
